# Copy to .env; never commit real credentials.
DATABASE_URL=
DATABASE_PATH=data/prospects.sqlite3
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
PARSER_API_KEY=
# GigaChat research and semantic review share the run's model-call budget.
ENABLE_TOOL_RESEARCH=true
ENABLE_SEMANTIC_CRITIC=true
ENABLE_OCR=true
OCR_LANGUAGES=rus+eng
DOCUMENT_DIR=data/originals
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
ENABLE_YANDEX=false
# Structural checks only; legal/semantic review still requires a human.
ENABLE_RULE_CRITIC=false
