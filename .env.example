# Copy to .env; never commit real credentials.
DATABASE_URL=
DATABASE_PATH=data/prospects.sqlite3
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
PARSER_API_KEY=
# Opt in to the bounded GigaChat research agent (uses the shared model-call budget).
ENABLE_TOOL_RESEARCH=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
ENABLE_YANDEX=false
